# ─────────────────────────────────────────────────────────────────────────────
# Moani — Environment Variables
#
# Copy this file to .env and fill in real values before running the app.
# Never commit .env to source control.
# ─────────────────────────────────────────────────────────────────────────────

# ─── Server ──────────────────────────────────────────────────────────────────

# Port the HTTP server listens on (default: 3000)
PORT=3000

# ─── Database (Supabase Postgres) ────────────────────────────────────────────

# Direct / session-mode pooler URL used by the running application.
# Use port 5432 (direct) or the session-mode pooler — NOT the transaction
# pooler (port 6543) because Prisma uses prepared statements.
DATABASE_URL="postgresql://postgres.<ref>:<password>@<host>:5432/postgres"

# Session-mode URL used by Prisma CLI commands (migrate dev / migrate deploy).
# Can be the same as DATABASE_URL; never use the transaction pooler here.
MIGRATE_URL="postgresql://postgres.<ref>:<password>@<host>:5432/postgres"

# ─── Auth / JWT ──────────────────────────────────────────────────────────────

# Long, random secret used to sign all JWTs (access tokens, reset tokens, etc.)
# Generate with: openssl rand -hex 32
JWT_SECRET="replace-with-a-long-random-hex-string"

# How long access tokens stay valid. Supports ms-library notation: 7d, 24h, 3600s.
JWT_EXPIRES_IN="7d"

# ─── OTP ─────────────────────────────────────────────────────────────────────

# How long phone-verification OTPs live in Redis (minutes). Default: 10.
OTP_TTL_MINUTES="10"

# ─── Password Reset ───────────────────────────────────────────────────────────

# How long a reset session (resetSessionId JWT + DB row) stays valid (minutes).
# Covers initiate → chooseMethod → verifyOtp / email link click. Default: 10.
PASSWORD_RESET_SESSION_TTL_MINUTES="10"

# How long the single-use resetToken (issued after OTP / email verification)
# is valid before POST /auth/password-reset/complete must be called (seconds).
# Default: 300 (5 minutes).
PASSWORD_RESET_TOKEN_TTL_SECONDS="300"

# ─── Redis (Upstash) ─────────────────────────────────────────────────────────

# Full Upstash Redis TLS URL. Format: rediss://default:<password>@<host>:6379
# Required for OTP storage and (currently) logout token blacklist.
# NOTE: The logout blacklist is in-memory by default; Redis is used for OTP only.
# TODO: Move the token blacklist to Redis when running more than one instance.
REDIS_URL="rediss://default:<password>@<upstash-host>.upstash.io:6379"

# ─── Email — Resend ──────────────────────────────────────────────────────────

# Resend API key. Omit or set to "dev" to enable stub-log mode (no real sends).
# Get your key at https://resend.com
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# Verified sender address configured in your Resend domain.
RESEND_FROM_EMAIL="noreply@yourdomain.com"

# ─── SMS / WhatsApp — Africa's Talking ───────────────────────────────────────

# Africa's Talking API key. Omit or set to "dev" to enable stub-log mode.
# Get your key at https://africastalking.com
AT_API_KEY="xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# Africa's Talking username (use "sandbox" for the sandbox environment).
AT_USERNAME="sandbox"

# Optional sender ID registered with Africa's Talking (leave blank to use default).
AT_SENDER_ID=""

# Africa's Talking WhatsApp-enabled number (E.164 format, e.g. +237600000000).
# Only required if you use the whatsapp OTP/reset-link channel.
AT_WHATSAPP_NUMBER=""

# ─── Frontend / Deep Links ───────────────────────────────────────────────────

# Base URL of the frontend app. Used to build password-reset deep links sent
# via SMS and email (e.g. https://app.moani.cm).
FRONTEND_URL="http://localhost:3000"
