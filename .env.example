# =============================================================================
# Moani / Finda Backend — Environment Configuration (.env.example)
# =============================================================================

# =============================================================================
# Database
# =============================================================================

# Direct or session-mode PostgreSQL connection string used at runtime by PrismaClient.
DATABASE_URL="postgresql://postgres.your-project-ref:your-supabase-password@your-supabase-host:5432/postgres"

# Direct or session-mode PostgreSQL connection string used by Prisma CLI for migrations.
MIGRATE_URL="postgresql://postgres.your-project-ref:your-supabase-password@your-supabase-host:5432/postgres"

# Redis TLS connection string (Upstash) used for OTP caching and session state.
REDIS_URL="rediss://default:your-redis-password@your-upstash-host.upstash.io:6379"

# =============================================================================
# Auth/JWT
# =============================================================================

# Secret key used for signing and verifying JWT access and reset tokens.
JWT_SECRET="your-jwt-secret-key-min-32-chars-hex"

# Lifespan duration for JWT access tokens (e.g., 7d, 24h, 3600s).
JWT_EXPIRES_IN="7d"

# Time-to-live in minutes for password reset sessions before expiration.
PASSWORD_RESET_SESSION_TTL_MINUTES="10"

# Time-to-live in seconds for single-use password reset tokens after verification.
PASSWORD_RESET_TOKEN_TTL_SECONDS="300"

# Base URL of the client frontend application used to construct password reset links.
FRONTEND_URL="http://localhost:3000"

# =============================================================================
# OTP
# =============================================================================

# Time-to-live in minutes for phone and email verification OTPs in Redis.
OTP_TTL_MINUTES="10"

# =============================================================================
# Africa's Talking
# =============================================================================

# Africa's Talking API key for SMS and WhatsApp OTP delivery.
# TODO: not yet created — OTP falls back to console log without this
AT_API_KEY="your-africas-talking-api-key"

# Africa's Talking username (use 'sandbox' for development/testing).
# TODO: not yet created — OTP falls back to console log without this
AT_USERNAME="your-africas-talking-username"

# Optional registered alphanumeric sender ID for SMS messages.
# TODO: not yet created — OTP falls back to console log without this
AT_SENDER_ID="your-sender-id"

# Africa's Talking WhatsApp business sender phone number in E.164 format.
# TODO: not yet created — OTP falls back to console log without this
AT_WHATSAPP_NUMBER="+237600000000"

# =============================================================================
# Resend
# =============================================================================

# Resend API key for transactional email delivery (leave empty or 'dev' for console stub).
RESEND_API_KEY="re_your-resend-api-key"

# Verified sender email address configured in Resend.
RESEND_FROM_EMAIL="noreply@yourdomain.com"

# =============================================================================
# Firebase
# =============================================================================

# Google Cloud / Firebase project ID for Firebase Cloud Messaging push notifications.
FIREBASE_PROJECT_ID="your-firebase-project-id"

# Firebase service account client email for Firebase Admin SDK authentication.
FIREBASE_CLIENT_EMAIL="firebase-adminsdk-xxx@your-firebase-project-id.iam.gserviceaccount.com"

# Firebase service account private key for Firebase Admin SDK authentication.
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nyour-firebase-private-key\n-----END PRIVATE KEY-----\n"

# =============================================================================
# Sentry
# =============================================================================

# Sentry Data Source Name (DSN) URL for error tracking and performance monitoring.
SENTRY_DSN="https://your-sentry-key@o0.ingest.sentry.io/0000000"

# Deployment environment identifier reported to Sentry (development, staging, production).
SENTRY_ENVIRONMENT="development"

# =============================================================================
# Payment Rails (Campay/PawaPay)
# =============================================================================

# Campay API username for mobile money collections and disbursements.
CAMPAY_USERNAME="your-campay-username"

# Campay API password.
CAMPAY_PASSWORD="your-campay-password"

# Campay permanent application token for API authorization.
CAMPAY_APP_TOKEN="your-campay-app-token"

# Campay environment mode (DEV or PROD).
CAMPAY_ENVIRONMENT="DEV"

# PawaPay API authorization bearer token for mobile money aggregation.
PAWAPAY_API_TOKEN="your-pawapay-api-token"

# PawaPay environment mode (sandbox or production).
PAWAPAY_ENVIRONMENT="sandbox"

# =============================================================================
# App/Port config
# =============================================================================

# Port number for the NestJS HTTP server to listen on (defaults to 3000).
PORT=3000

# Application runtime environment (development, test, production).
NODE_ENV="development"
