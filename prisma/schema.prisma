generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs" // NestJS runs on CommonJS
}

datasource db {
  provider = "postgresql"
  // url and directUrl live in prisma.config.ts in Prisma v7
}

// ── Enums ────────────────────────────────────────────────────────────────────
enum Role {
  USER
  ADMIN
}

// ── Models ───────────────────────────────────────────────────────────────────
model User {
  id                 String   @id @default(uuid())
  phone              String   @unique
  isPhoneVerified    Boolean  @default(false)
  email              String?  @unique
  firstName          String
  lastName           String
  passwordHash       String
  dateOfBirth        DateTime
  transactionPinHash String
  role               Role     @default(USER)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@map("users")
}

model PhoneOtp {
  id         String    @id @default(uuid())
  phone      String
  codeHash   String
  expiresAt  DateTime
  attempts   Int       @default(0)
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([phone])
  @@map("phone_otps")
}
